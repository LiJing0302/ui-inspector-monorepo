{
  "name": "@ui-inspector/ai-acceptance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SAMA: Structure-Anchored + Multi-region AI review — offline AI acceptance engine (pure TS core + Node CLI)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "ai-acceptance": "src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:self": "node --experimental-strip-types src/__tests__/run.ts",
    "core:isolated": "node --experimental-strip-types src/__tests__/assert-core-isolated.ts",
    "probe:workspace": "node --experimental-strip-types src/__tests__/probe_workspace.ts",
    "accept": "node --experimental-strip-types src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "5.6.3"
  }
}
