{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "outDir": "./node_modules/.tmp/tsc-node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // SAMA 引擎（@ui-inspector/ai-acceptance）的源码是「直跑 TS」形态：
    // 包内相对导入带 `.ts` 后缀（Node 的 --experimental-strip-types 要求显式扩展名）。
    // 主进程通过 `exports` 直接消费它的 .ts 源码，所以这里必须放行 `.ts` 后缀导入。
    // 该选项要求 noEmit —— typecheck 脚本本来就传了 `--noEmit`。
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/types/*"]
    },
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/types/**/*.ts",
    "electron.vite.config.ts",
    // 冒烟测试是主进程管线唯一的自动化验证手段，必须纳入类型检查：
    // 它此前不在 include 里，漏了个 import 也能「类型检查通过」，只在运行时炸。
    "scripts/**/*.ts"
  ]
}
