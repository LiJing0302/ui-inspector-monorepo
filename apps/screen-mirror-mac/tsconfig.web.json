{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "outDir": "./node_modules/.tmp/tsc-web",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // `src/types/sama.ts` 直接引用 SAMA 引擎包（@ui-inspector/ai-acceptance）的类型，
    // 而该包的源码是「直跑 TS」形态（相对导入带 `.ts` 后缀）—— 渲染层要能解析它。
    // 该选项要求 noEmit —— typecheck 脚本本来就传了 `--noEmit`。
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@shared/*": ["src/types/*"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/types/**/*.ts"
  ]
}
