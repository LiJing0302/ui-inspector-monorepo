{
  "name": "screen-mirror-mac",
  "version": "1.0.0",
  "description": "UI 验收投屏：iPhone(WiFi/ReplayKit) + Android(USB/scrcpy) 投屏到 Mac，含设计稿验收",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:verify": "SM_VERIFY=1 electron-vite dev",
    "start": "electron-vite preview",
    "start:verify": "SM_VERIFY=1 electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit --composite false -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit --composite false -p tsconfig.web.json",
    "setup:livekit": "node scripts/setup-livekit.js",
    "verify:livekit": "electron scripts/verify-livekit.js",
    "verify:iphone": "node --test scripts/verify-iphone.test.js",
    "verify:packaged": "electron scripts/verify-livekit.js --packaged",
    "test:verify-smoke": "esbuild scripts/verify-import-smoke.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --alias:@shared=./src/types --external:electron --external:ws \"--external:@yume-chan/*\" --outfile=.smoke/smoke.mjs --log-level=warning && electron .smoke/smoke.mjs",
    "test:inspector-smoke": "esbuild src/main/inspector/inspectorBridge.ts --bundle --platform=node --format=esm --external:ws --outfile=.smoke/inspector-bridge.mjs --log-level=warning && node scripts/inspector-bridge-smoke.mjs",
    "probe:match": "esbuild scripts/probe-match-engine.ts --bundle --platform=node --format=esm --outfile=.smoke/probe.mjs --log-level=warning && node .smoke/probe.mjs",
    "probe:sama": "esbuild scripts/probe-sama.ts --bundle --platform=node --format=esm --packages=external --alias:@shared=./src/types --outfile=.smoke/sama-probe.mjs --log-level=warning && node .smoke/sama-probe.mjs",
    "replay:gt": "esbuild scripts/replay-ground-truth.ts --bundle --platform=node --format=esm --outfile=.smoke/replay-gt.mjs --log-level=warning && node .smoke/replay-gt.mjs",
    "gt:sheet": "esbuild scripts/gen-ground-truth-sheet.ts --bundle --platform=node --format=esm --outfile=.smoke/gt-sheet.mjs --log-level=warning && node .smoke/gt-sheet.mjs",
    "check:livekit": "node scripts/check-livekit.js",
    "prepack": "node scripts/check-livekit.js",
    "predist": "node scripts/check-livekit.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac",
    "test:manual-acceptance": "esbuild scripts/manual-acceptance-smoke.ts --bundle --platform=node --format=esm --alias:@shared=./src/types --outfile=.smoke/manual-acceptance.mjs --log-level=warning && node .smoke/manual-acceptance.mjs && esbuild ../../packages/react-native-ui-acceptance/scripts/manual-context-smoke.ts --bundle --platform=node --format=esm --alias:react-native=../../packages/react-native-ui-acceptance/scripts/fixtures/acceptance-rn.ts --outfile=.smoke/sdk-context.mjs --log-level=warning && node .smoke/sdk-context.mjs",
    "test:manual-integration": "esbuild scripts/manual-acceptance-integration.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --alias:@shared=./src/types --external:electron --external:ws \"--external:@yume-chan/*\" --outfile=.smoke/manual-integration.mjs --log-level=warning && electron .smoke/manual-integration.mjs"
  },
  "build": {
    "appId": "com.ehaier.screenmirror.mac",
    "productName": "UI 验收投屏",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "^8.18.1",
    "@ui-inspector/ai-acceptance": "workspace:*",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.24.2",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "2.3.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "dependencies": {
    "@ui-inspector/protocol": "workspace:*",
    "@yume-chan/adb": "^3.0.0-beta.2",
    "@yume-chan/adb-scrcpy": "^3.0.0-beta.2",
    "@yume-chan/adb-server-node-tcp": "^3.0.0-beta.2",
    "jszip": "^3.10.2",
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "^8.21.3"
  }
}
